# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ── Database / uploads (persist these two paths on a volume!) ──
DATABASE_PATH=./data/karigar.db
UPLOAD_DIR=./data/uploads

# ── First admin (used only when the database is empty) ──
ADMIN_EMAIL=you@your-domain.com
ADMIN_PASSWORD=choose-a-long-unique-password

# ── Razorpay (Dashboard → Settings → API Keys; Webhooks) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (https://resend.com). Without it emails are only logged in the admin outbox ──
RESEND_API_KEY=
EMAIL_FROM="Naaz Creation <orders@your-domain.com>"

# ── Misc ──
CRON_SECRET=generate-a-random-string      # protects /api/cron/abandoned-carts
NEWSLETTER_SECRET=generate-a-random-string # signs unsubscribe links
# MOCK_PAYMENTS=1   # NEVER set in production once Razorpay keys exist (mock is auto-disabled with keys anyway)
